  <diagram id="media-pipeline" name="2 - Media Pipeline">
    <mxGraphModel dx="1400" dy="620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0p"/>
        <mxCell id="1p" parent="0p"/>
        <mxCell id="mp-title" value="Media-processing pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=26;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1p"><mxGeometry x="40" y="25" width="420" height="40" as="geometry"/></mxCell>
        <mxCell id="mp-subtitle" value="DeepFilterNet receives audio; FFmpeg handles the video container before and after inference" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#475569;" vertex="1" parent="1p"><mxGeometry x="40" y="65" width="700" height="30" as="geometry"/></mxCell>
        <mxCell id="mp-upload" value="&lt;b&gt;Uploaded video&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;MP4, MOV, WebM, AVI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=14;shadow=1;" vertex="1" parent="1p"><mxGeometry x="35" y="190" width="150" height="120" as="geometry"/></mxCell>
        <mxCell id="mp-extract" value="&lt;b&gt;FFmpeg&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;remove video&lt;br&gt;mono • 48 kHz&lt;br&gt;PCM 16-bit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#93C5FD;fontSize=14;shadow=1;" vertex="1" parent="1p"><mxGeometry x="225" y="170" width="165" height="160" as="geometry"/></mxCell>
        <mxCell id="mp-wav-in" value="&lt;b&gt;Input WAV&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;temporary workspace&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=14;shadow=1;" vertex="1" parent="1p"><mxGeometry x="430" y="190" width="150" height="120" as="geometry"/></mxCell>
        <mxCell id="mp-dfn" value="&lt;b&gt;DeepFilterNet3&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;PyTorch CPU&lt;br&gt;full-band speech&lt;br&gt;enhancement&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#5EEAD4;fontSize=14;shadow=1;" vertex="1" parent="1p"><mxGeometry x="620" y="165" width="175" height="170" as="geometry"/></mxCell>
        <mxCell id="mp-wav-out" value="&lt;b&gt;Enhanced WAV&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;cleaner speech track&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontSize=14;shadow=1;" vertex="1" parent="1p"><mxGeometry x="835" y="190" width="150" height="120" as="geometry"/></mxCell>
        <mxCell id="mp-mux" value="&lt;b&gt;FFmpeg&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;original video&lt;br&gt;enhanced audio&lt;br&gt;H.264 + AAC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#93C5FD;fontSize=14;shadow=1;" vertex="1" parent="1p"><mxGeometry x="1025" y="170" width="165" height="160" as="geometry"/></mxCell>
        <mxCell id="mp-output" value="&lt;b&gt;Processed MP4&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;completed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=14;shadow=1;" vertex="1" parent="1p"><mxGeometry x="1230" y="190" width="140" height="120" as="geometry"/></mxCell>
        <mxCell id="mp-fallback" value="&lt;b&gt;Fallback handler&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;log error&lt;br&gt;copy original upload&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontSize=14;shadow=1;" vertex="1" parent="1p"><mxGeometry x="555" y="440" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="mp-original" value="&lt;b&gt;Original video available&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;fallback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=14;shadow=1;" vertex="1" parent="1p"><mxGeometry x="965" y="440" width="245" height="105" as="geometry"/></mxCell>
        <mxCell id="mp-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1p" source="mp-upload" target="mp-extract"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mp-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1p" source="mp-extract" target="mp-wav-in"><mxGeometry relative="1" as="geometry"/></mxCell>
