        <mxCell id="dd-db" value="&lt;b&gt;mysql:8.4&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;queue + cache + failures&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=15;shadow=1;" vertex="1" parent="1d"><mxGeometry x="410" y="485" width="245" height="125" as="geometry"/></mxCell>
