  <diagram id="job-lifecycle" name="4 - Job Lifecycle">
    <mxGraphModel dx="1200" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0j"/>
        <mxCell id="1j" parent="0j"/>
        <mxCell id="jl-title" value="Job lifecycle" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=26;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1j"><mxGeometry x="40" y="25" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="jl-subtitle" value="Fallback is a usable result; failed means both enhancement and original-file publication failed" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#475569;" vertex="1" parent="1j"><mxGeometry x="40" y="65" width="760" height="30" as="geometry"/></mxCell>
        <mxCell id="jl-start" value="" style="ellipse;html=1;aspect=fixed;fillColor=#0F172A;strokeColor=#0F172A;" vertex="1" parent="1j"><mxGeometry x="56" y="231" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="jl-pending" value="&lt;b&gt;Pending&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;progress 0&lt;br&gt;waiting for worker&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=15;shadow=1;" vertex="1" parent="1j"><mxGeometry x="115" y="190" width="180" height="110" as="geometry"/></mxCell>
        <mxCell id="jl-extract" value="&lt;b&gt;Processing&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;progress 20&lt;br&gt;extract audio&lt;br&gt;FFmpeg&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#93C5FD;fontSize=15;shadow=1;" vertex="1" parent="1j"><mxGeometry x="365" y="175" width="210" height="140" as="geometry"/></mxCell>
        <mxCell id="jl-enhance" value="&lt;b&gt;Processing&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;progress 50&lt;br&gt;enhance and remux&lt;br&gt;DFN3 + FFmpeg&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#5EEAD4;fontSize=15;shadow=1;" vertex="1" parent="1j"><mxGeometry x="645" y="175" width="210" height="140" as="geometry"/></mxCell>
        <mxCell id="jl-completed" value="&lt;b&gt;Completed&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;progress 100&lt;br&gt;enhanced MP4 available&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=15;shadow=1;" vertex="1" parent="1j"><mxGeometry x="930" y="190" width="210" height="110" as="geometry"/></mxCell>
