  <diagram id="system-architecture" name="1 - System Architecture">
    <mxGraphModel dx="1200" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="sa-title" value="System architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="320" height="40" as="geometry"/></mxCell>
        <mxCell id="sa-subtitle" value="HTTP orchestration stays separate from CPU-intensive speech enhancement" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="600" height="30" as="geometry"/></mxCell>
        <mxCell id="sa-boundary" value="Docker Compose application boundary" style="swimlane;html=1;rounded=1;startSize=44;horizontal=1;fillColor=#F8FAFC;strokeColor=#94A3B8;dashed=1;dashPattern=8 6;fontSize=16;fontStyle=1;fontColor=#0F172A;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="205" y="105" width="950" height="565" as="geometry"/></mxCell>
        <mxCell id="sa-client" value="&lt;b&gt;API client&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Browser, mobile app&lt;br&gt;or backend service&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=15;fontColor=#0F172A;shadow=1;" vertex="1" parent="1"><mxGeometry x="28" y="265" width="145" height="105" as="geometry"/></mxCell>
        <mxCell id="sa-api" value="&lt;b&gt;Laravel API&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;validate and store uploads&lt;br&gt;create job status&lt;br&gt;dispatch queue job&lt;br&gt;serve status responses&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#93C5FD;fontSize=15;fontColor=#0F172A;shadow=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="260" y="190" width="255" height="170" as="geometry"/></mxCell>
        <mxCell id="sa-worker" value="&lt;b&gt;Queue worker&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;FFmpeg extraction and mux&lt;br&gt;DeepFilterNet3 CPU inference&lt;br&gt;progress, logging, fallback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#CCFBF1;strokeColor=#5EEAD4;fontSize=15;fontColor=#0F172A;shadow=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="660" y="170" width="320" height="210" as="geometry"/></mxCell>
        <mxCell id="sa-db" value="&lt;b&gt;MySQL&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;queue, cache, failures&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=15;fontColor=#0F172A;shadow=1;" vertex="1" parent="1"><mxGeometry x="260" y="475" width="220" height="125" as="geometry"/></mxCell>
        <mxCell id="sa-private" value="&lt;b&gt;Private storage&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;original uploads&lt;/font&gt;" style="shape=folder;tabWidth=70;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=15;fontColor=#0F172A;shadow=1;" vertex="1" parent="1"><mxGeometry x="565" y="475" width="225" height="125" as="geometry"/></mxCell>
        <mxCell id="sa-public" value="&lt;b&gt;Public storage&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;processed or fallback MP4&lt;/font&gt;" style="shape=folder;tabWidth=70;tabHeight=18;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#ECFDF5;strokeColor=#059669;fontSize=15;fontColor=#0F172A;shadow=1;" vertex="1" parent="1"><mxGeometry x="865" y="475" width="225" height="125" as="geometry"/></mxCell>
        <mxCell id="sa-e1" value="upload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontColor=#334155;fontSize=12;" edge="1" parent="1" source="sa-client" target="sa-api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sa-e2" value="dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontColor=#334155;fontSize=12;" edge="1" parent="1" source="sa-api" target="sa-worker"><mxGeometry relative="1" as="geometry"/></mxCell>
