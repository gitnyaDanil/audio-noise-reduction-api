        <mxCell id="dd-e3" value="SQL" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontColor=#334155;" edge="1" parent="1d" source="dd-app" target="dd-db"><mxGeometry relative="1" as="geometry"/></mxCell>
