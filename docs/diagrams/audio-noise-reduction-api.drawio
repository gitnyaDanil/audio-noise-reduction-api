        <mxCell id="mp-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1p" source="mp-dfn" target="mp-wav-out"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mp-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1p" source="mp-wav-out" target="mp-mux"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mp-e6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1p" source="mp-mux" target="mp-output"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mp-e7" value="processing error" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#B91C1C;strokeWidth=2;dashed=1;dashPattern=7 5;endArrow=block;endFill=1;fontColor=#B91C1C;" edge="1" parent="1p" source="mp-dfn" target="mp-fallback"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mp-e8" value="copy succeeds" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1p" source="mp-fallback" target="mp-original"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
