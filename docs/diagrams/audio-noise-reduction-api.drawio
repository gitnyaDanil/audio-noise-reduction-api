        <mxCell id="dd-e1" value="HTTP :8080 → :80" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontColor=#334155;" edge="1" parent="1d" source="dd-client" target="dd-app"><mxGeometry relative="1" as="geometry"/></mxCell>
